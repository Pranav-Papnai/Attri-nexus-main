# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values. backend/src/config.js reads backend/.env.local, then this directory's
# .env.local, then .env. A real shell/CI variable always wins over all of them.
#
# NEVER put real credentials in this file — it is committed to git.

# ---- Required: the server refuses to start without this ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Database ----
MONGODB_URI=

# ---- Optional features ----
BLOB_READ_WRITE_TOKEN=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
# Must be a verified sender on your Resend domain, e.g. "Attri Nexus <enquiries@attrinexus.com>"
FROM_EMAIL=

# ---- Server ----
PORT=3001
# Leave as development on your own machine. If unset the server assumes
# production (no CAPTCHA test tokens, no public API docs, generic errors).
NODE_ENV=development
# Every origin the site is served from. Browsers send Origin on same-site
# POST/PATCH/DELETE too, so on the server this must include the live URL,
# e.g. https://attrinexus.com,https://www.attrinexus.com
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (docker-compose sets 2).
# TRUST_PROXY_HOPS=1
# Serve Swagger UI at /api/docs in production too (off by default).
# ENABLE_API_DOCS=false

# ---- Docker / EC2 deployment ----
# Domain(s) for automatic HTTPS via Caddy. Leave unset for plain HTTP on :80.
# SITE_ADDRESS=attrinexus.com, www.attrinexus.com
# Turns on MongoDB authentication for the bundled mongodb container (only when
# its data volume is first created). MONGODB_URI must then include them.
# MONGO_ROOT_USERNAME=
# MONGO_ROOT_PASSWORD=

# ---- Frontend ----
VITE_TURNSTILE_SITE_KEY=

# ---- Extra service config ----
CLOUDINARY_URL=
