# Public entry point for the Docker / EC2 deployment.
#
# SITE_ADDRESS (set in .env next to docker-compose.yml):
#   attrinexus.com, www.attrinexus.com  -> automatic HTTPS: Caddy obtains and
#                                         renews Let's Encrypt certificates and
#                                         redirects http:// to https://.
#                                         The domain's DNS must point at this
#                                         server and ports 80 + 443 must be open.
#   :80 (default)                        -> plain HTTP, for local testing only.
{$SITE_ADDRESS::80} {
	encode gzip

	header {
		# Ignored by browsers over plain HTTP, enforced once served over HTTPS.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	# Caddy discards any X-Forwarded-For sent by the client and sets it to the
	# real peer address, so the backend's TRUST_PROXY_HOPS=2 cannot be spoofed.
	reverse_proxy frontend:8080
}
