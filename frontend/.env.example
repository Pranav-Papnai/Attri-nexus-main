# Attri Nexus Frontend Environment Variables

# Optional: Custom Backend URL (only needed if frontend and backend are on separate domains)
# Example: VITE_API_BASE_URL=https://api.attrinexus.com
# If left blank, requests use relative '/api/*' which works with Vite dev proxy and Docker Nginx
VITE_API_BASE_URL=

# Cloudflare Turnstile CAPTCHA Site Key (Public)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEbYxH0hs9UIym6l
